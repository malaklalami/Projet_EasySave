<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasyAvalonia.MainWindow"
        Title="EasySave v2.0 - Gestionnaire de Sauvegarde"
        Width="950" Height="650"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="🛡️ EasySave v2.0" FontSize="28" FontWeight="ExtraBold" VerticalAlignment="Center"/>
            <Separator Width="20" Background="Transparent"/>
            <Button Content="Changer Langue" Click="OnLanguageClick" Background="#444" Foreground="White"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#252525" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="15">
                <StackPanel>
                    <TextBlock Text="Logiciel Métier :" FontSize="10" Foreground="Gray"/>
                    <TextBox Name="TxtBusinessSoft" Width="150" Watermark="ex: Calculator" Text="Calculator"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Format Log :" FontSize="10" Foreground="Gray"/>
                    <ComboBox Name="ComboLogFormat" Width="100" SelectedIndex="0">
                        <ComboBoxItem Content="JSON"/>
                        <ComboBoxItem Content="XML"/>
                    </ComboBox>
                </StackPanel>
                <Button Content="💾 Sauver Params" VerticalAlignment="Bottom" Background="#34495e" Click="OnSaveParamsClick"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#1e1e1e" CornerRadius="10" Padding="15">
            <ScrollViewer>
                <StackPanel Name="JobsContainer">
                    <Border Background="#2d2d2d" Margin="0,5" Padding="15" CornerRadius="8">
                        <Grid ColumnDefinitions="*, 2*, Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sauvegarde_Photos" FontWeight="Bold" FontSize="16" Foreground="#3498db"/>
                                <TextBlock Text="Statut: En attente" FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Source: C:\Users\Images" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Cible: D:\Backups\Photos" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                <Button Content="▶ Lancer" Background="#27ae60" Click="OnBackupClick"/>
                                <Button Content="⚙️" Background="#f39c12" Click="OnSettingsClick"/>
                                <Button Content="🗑️" Background="#e74c3c" Click="OnDeleteClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="0,20,0,0">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="Progression globale : 0%" FontSize="12" Margin="0,0,0,5"/>
                <ProgressBar Height="10" Value="0" Maximum="100" Foreground="#3498db"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Content="+ Nouveau Travail" Click="OnAddJobClick" Padding="15,10" Background="#3498db" FontWeight="Bold"/>
                <Button Content="Lancer tout" Click="OnBackupAllClick" Padding="15,10" Background="#2ecc71" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>