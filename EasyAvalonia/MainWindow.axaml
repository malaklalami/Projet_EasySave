<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasyAvalonia.MainWindow"
        Title="EasySave v2.0 - Gestionnaire de Sauvegarde"
        Width="950" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#1a1c1e" Foreground="#e2e8f0"> <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="25">
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="🛡️ EasySave" FontSize="30" FontWeight="Black" Foreground="#60a5fa" VerticalAlignment="Center"/>
            <TextBlock Text="v3.0" FontSize="14" Foreground="#94a3b8" VerticalAlignment="Bottom" Margin="10,0,0,5"/>
            <Separator Width="30" Background="Transparent"/>
            <Button Content="Changer Langue" Click="OnLanguageClick" 
                    Background="#334155" Foreground="White" CornerRadius="5"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#25292e" CornerRadius="12" Padding="15" Margin="0,0,0,15" 
                BoxShadow="0 4 10 0 #000000">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <StackPanel>
                    <TextBlock Text="LOGICIEL MÉTIER" FontSize="10" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,5"/>
                    <TextBox Name="TxtBusinessSoft" Width="180" Background="#1a1c1e" BorderBrush="#334155" 
                             Watermark="ex: Calculator" Text="Calculator" Foreground="White"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="FORMAT LOG" FontSize="10" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                    <ComboBox Name="ComboLogFormat" Width="120" Background="#1a1c1e" SelectedIndex="0">
                        <ComboBoxItem Content="JSON"/>
                        <ComboBoxItem Content="XML"/>
                    </ComboBox>
                </StackPanel>
                <Button Content="Enregistrer les paramètres" VerticalAlignment="Bottom" 
                        Background="#3b82f6" Foreground="White" Padding="15,7" CornerRadius="6"
                        Click="OnSaveParamsClick"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#25292e" CornerRadius="12" Padding="10">
            <ScrollViewer>
                <StackPanel Name="JobsContainer" Spacing="8">
                    
                    <Border Background="#2e343b" Padding="18" CornerRadius="10" BorderBrush="#3d444d" BorderThickness="1">
                        <Grid ColumnDefinitions="*, 2*, Auto">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Sauvegarde_Photos" FontWeight="SemiBold" FontSize="17" Foreground="#60a5fa"/>
                                <TextBlock Text="Statut: En attente" FontSize="12" Foreground="#94a3b8"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="SRC: C:\Users\Images" FontSize="11" Foreground="#cbd5e1"/>
                                <TextBlock Text="DST: D:\Backups\Photos" FontSize="11" Foreground="#cbd5e1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                                <Button Content="▶ Lancer" Background="#10b981" Foreground="White" FontWeight="Bold" Width="90" Click="OnBackupClick"/>
                                <Button Content="⚙️" Background="#475569" Foreground="White" Click="OnSettingsClick"/>
                                <Button Content="🗑️" Background="#ef4444" Foreground="White" Click="OnDeleteClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="0,20,0,0">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,30,0">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Progression globale" FontSize="12" Foreground="#94a3b8"/>
                    <TextBlock Grid.Column="1" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#60a5fa"/>
                </Grid>
                <ProgressBar Height="8" Value="0" Maximum="100" Foreground="#3b82f6" Background="#334155" Margin="0,8,0,0" CornerRadius="4"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                <Button Content="+ Nouveau" Click="OnAddJobClick" Padding="20,12" 
                        Background="#334155" BorderBrush="#475569" BorderThickness="1" Foreground="White"/>
                <Button Content="Lancer Tout" Click="OnBackupAllClick" Padding="25,12" 
                        Background="#3b82f6" Foreground="White" FontWeight="Bold" CornerRadius="8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>