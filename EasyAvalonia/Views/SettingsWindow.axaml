<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasyAvalonia.Views.SettingsWindow"
        Title="Configuration ProSoft v3.0" Width="550" Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#D4D4D4">

    <ScrollViewer>
        <StackPanel Margin="25" Spacing="20">
            <TextBlock Text="PARAMÈTRES SYSTÈME" FontSize="20" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,10"/>

            <Border Background="#2D2D30" Padding="15" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="Format des logs " FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Choissisez le format de sortie des fichiers journaux :" FontSize="12" Foreground="#888888"/>
                    <ComboBox Name="LogFormatCombo" Width="200" HorizontalAlignment="Left" Background="#1E1E1E">
                        <ComboBoxItem Content="Json"/>
                        <ComboBoxItem Content="Xml"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Background="#2D2D30" Padding="15" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="Performance &amp; Bande Passante" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Seuil de transfert simultané (n Ko) :" FontSize="12"/>
                        <TextBox Name="LargeFileThresholdInput" Watermark="Ex: 1024" Background="#1E1E1E" BorderBrush="#333333"/>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Nombre maximum de copies en parallèle :" FontSize="12"/>
                        <NumericUpDown Name="MaxParallelInput" Minimum="1" Maximum="10" Value="4" Background="#1E1E1E"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#2D2D30" Padding="15" CornerRadius="8">
                <Grid ColumnDefinitions="*, *">
                    <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,10,0">
                        <TextBlock Text="Prioritaires" FontWeight="Bold" Foreground="White" FontSize="12"/>
                        <TextBox Name="PriorityExtensionsInput" Watermark=".pdf, .docx" Height="100" AcceptsReturn="True" Background="#1E1E1E" BorderBrush="#333333"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="À Crypter" FontWeight="Bold" Foreground="White" FontSize="12"/>
                        <TextBox Name="CryptoExtensionsInput" Watermark=".txt, .pdf" Height="100" AcceptsReturn="True" Background="#1E1E1E" BorderBrush="#333333"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#2D2D30" Padding="15" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="Logiciel Metier (Surveillance)" FontWeight="Bold" Foreground="White"/>
                    <TextBox Name="BusinessSoftwareInput" Watermark="Ex: calculator.exe" Background="#1E1E1E" BorderBrush="#333333"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Content="Annuler" Click="Cancel_Click" Background="Transparent" BorderBrush="#333333" BorderThickness="1"/>
                <Button Content=" Enregistrer" Click="Save_Click" 
                        Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="25,12" CornerRadius="5"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>