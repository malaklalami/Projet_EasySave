<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="EasyAvalonia.Views.SettingsWindow"
    Title="Configuration ProSoft v3.0" Width="750" Height="1000"
    WindowStartupLocation="CenterOwner"
    Background="#0D1117" Foreground="#E6EDF3">

<DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="30,20,30,20">
        <Button Content="Annuler" Click="Cancel_Click" Background="Transparent" Foreground="#E6EDF3" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="20,10"/>
        <Button Content=" Enregistrer" Click="Save_Click" Background="#238636" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="25,10"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel Margin="30,30,30,20" Spacing="25">
            <TextBlock Text="?? PARAMETRES SYSTEME" FontSize="22" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,15"/>

            <!-- LANGUE -->
            <Border Background="#161B22" Padding="20" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Langue" FontWeight="Bold" Foreground="#E6EDF3" FontSize="14"/>
                    <TextBlock Text="Selectionnez votre langue" FontSize="12" Foreground="#8B949E"/>
                    <ComboBox Name="LanguageCombo" Width="200" HorizontalAlignment="Left" Background="#0D1117" BorderBrush="#30363D" Foreground="#E6EDF3">
                        <ComboBoxItem Content="English"/>
                        <ComboBoxItem Content="Francais"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- FORMAT DES LOGS -->
            <Border Background="#161B22" Padding="20" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Format des logs" FontWeight="Bold" Foreground="#E6EDF3" FontSize="14"/>
                    <TextBlock Text="Choisissez le format de sortie des fichiers journaux" FontSize="12" Foreground="#8B949E"/>
                    <ComboBox Name="LogFormatCombo" Width="200" HorizontalAlignment="Left" Background="#0D1117" BorderBrush="#30363D" Foreground="#E6EDF3">
                        <ComboBoxItem Content="JSON"/>
                        <ComboBoxItem Content="XML"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- DESTINATION DES LOGS -->
            <Border Background="#161B22" Padding="20" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Destination des logs" FontWeight="Bold" Foreground="#E6EDF3" FontSize="14"/>
                    <TextBlock Text="Ou envoyer les fichiers de logs" FontSize="12" Foreground="#8B949E"/>
                    <ComboBox Name="LogTargetCombo" Width="200" HorizontalAlignment="Left" Background="#0D1117" BorderBrush="#30363D" Foreground="#E6EDF3">
                        <ComboBoxItem Content="Local"/>
                        <ComboBoxItem Content="Remote"/>
                        <ComboBoxItem Content="Both"/>
                    </ComboBox>
                    <StackPanel Spacing="8" Margin="0,10,0,0">
                        <TextBlock Text="Adresse IP du serveur distant" FontSize="11" Foreground="#8B949E"/>
                        <TextBox Name="RemoteIpInput" Watermark="Ex: 192.168.1.100" Background="#0D1117" BorderBrush="#30363D" Foreground="#E6EDF3" Padding="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- EXTENSIONS -->
            <Border Background="#161B22" Padding="20" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1">
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                    <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,15,0">
                        <TextBlock Text="Extensions Prioritaires" FontWeight="Bold" Foreground="#E6EDF3" FontSize="13"/>
                        <TextBlock Text="Fichiers traites en priorite" FontSize="11" Foreground="#8B949E"/>
                        <TextBox Name="PriorityExtensionsInput" Watermark=".pdf, .docx" Height="80" AcceptsReturn="True" 
                                 Background="#0D1117" BorderBrush="#30363D" Foreground="#E6EDF3" Padding="10" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="Extensions A Crypter" FontWeight="Bold" Foreground="#E6EDF3" FontSize="13"/>
                        <TextBlock Text="Fichiers a chiffrer" FontSize="11" Foreground="#8B949E"/>
                        <TextBox Name="CryptoExtensionsInput" Watermark=".txt, .pdf" Height="80" AcceptsReturn="True" 
                                 Background="#0D1117" BorderBrush="#30363D" Foreground="#E6EDF3" Padding="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- LOGICIEL METIER -->
            <Border Background="#161B22" Padding="20" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Logiciel Metier (Surveillance)" FontWeight="Bold" Foreground="#E6EDF3" FontSize="14"/>
                    <TextBlock Text="Application a surveiller durant les sauvegardes" FontSize="12" Foreground="#8B949E"/>
                    <TextBox Name="BusinessSoftwareInput" Watermark="Ex: calculator.exe" Background="#0D1117" BorderBrush="#30363D" Foreground="#E6EDF3" Padding="10"/>
                </StackPanel>
            </Border>

            <!-- PERFORMANCE -->
            <Border Background="#161B22" Padding="20" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1">
                <StackPanel Spacing="15">
                    <TextBlock Text="Performance et Bande Passante" FontWeight="Bold" Foreground="#E6EDF3" FontSize="14"/>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="Seuil de transfert simultane (Ko)" FontSize="12" Foreground="#8B949E"/>
                        <TextBox Name="LargeFileThresholdInput" Watermark="Ex: 1024" Background="#0D1117" BorderBrush="#30363D" Foreground="#E6EDF3" Padding="10"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="Nombre maximum de copies en parallele" FontSize="12" Foreground="#8B949E"/>
                        <NumericUpDown Name="MaxParallelInput" Minimum="1" Maximum="16" Value="4" Background="#0D1117" BorderBrush="#30363D" Foreground="#E6EDF3" Padding="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>