<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyAvalonia.ViewModels" 
        xmlns:views="using:EasyAvalonia.Views"
        x:DataType="views:MainWindow"
        x:Class="EasyAvalonia.Views.MainWindow"
        Title="EasySave - ProSoft Edition" Width="1000" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"> <DockPanel>
        
        <Border DockPanel.Dock="Top" Background="#111111" Height="70" Padding="20,0" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="💾" FontSize="32" VerticalAlignment="Center"/>
                    <TextBlock Text="EasySave" FontSize="28" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="V3.0" FontSize="14" Foreground="#007ACC" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </StackPanel>

                <Button Grid.Column="2" Content="⚙️ Paramètres" Click="OpenSettings_Click" 
                        Background="#2D2D30" Foreground="White" FontWeight="Bold" CornerRadius="5" Padding="15,10" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#252526" Height="80" Padding="20" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="⏸ Pause " Click="PauseAll_Click" Background="#4D4D4D" Foreground="White" FontWeight="Bold" CornerRadius="5"/>
                    <Button Content="▶ Reprise" Click="ResumeAll_Click" Background="#4D4D4D" Foreground="White" FontWeight="Bold" CornerRadius="5"/>
                    <Button Content="⏹ Stop" Click="StopAll_Click" Background="#660000" Foreground="White" FontWeight="Bold" CornerRadius="5"/>
                </StackPanel>
                
                <Button Grid.Column="2" Content=" LANCER LA SÉLECTION" Click="RunSelected_Click" 
                        Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="16" CornerRadius="5" Padding="20,10" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left" Width="250" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel Spacing="15">
                <TextBlock Text="GESTION" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,10"/>
                
                <Button Content="➕ Créer un travail" Click="CreateJob_Click" Width="220" Background="#007ACC" Foreground="White" FontWeight="Bold" CornerRadius="5" Padding="10"/>
                
                <Button Content=" Modifier la sélection" Click="EditJob_Click" Width="220" Background="#333337" Foreground="#D4D4D4" CornerRadius="5" Padding="10"/>
                <Button Content=" Supprimer la sélection" Click="DeleteJob_Click" Width="220" Background="#333337" Foreground="#FF6666" CornerRadius="5" Padding="10"/>
                
                <Border Height="1" Background="#333333" Margin="0,10"/>
                <Button Content="💣 Effacer tous les travaux" Click="ClearAll_Click" Width="220" Background="#660000" Foreground="White" FontWeight="Bold" CornerRadius="5" Padding="10"/>
            </StackPanel>
        </Border>

        <Grid Margin="20" RowDefinitions="Auto, *">
            <TextBlock Grid.Row="0" Text="Sélectionnez les travaux à lancer :" FontSize="18" FontWeight="Bold" Foreground="#D4D4D4" Margin="0,0,0,15"/>
            
            <ListBox Grid.Row="1" ItemsSource="{Binding DisplayJobs}" Background="Transparent" BorderThickness="0">
             <ListBox.ItemTemplate>
    <DataTemplate x:DataType="vm:JobDisplayModel">
        <Border CornerRadius="8" Padding="15" Margin="0,0,0,10" 
                BoxShadow="0 2 4 0 #40000000">
            <Border.Background>
                <Binding Path="Status" ConverterParameter="background">
                    <Binding.FallbackValue>#2D2D30</Binding.FallbackValue>
                </Binding>
            </Border.Background>

            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="180, *, 200, Auto">
                
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" 
                          Content="{Binding Job.Name}" Foreground="White" FontWeight="Bold"/>
                
                <ProgressBar Grid.Column="1" Value="{Binding Progress}" Minimum="0" Maximum="100" 
                             Height="15" Margin="20,0" Foreground="#007ACC" Background="#1E1E1E"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}"/>
                    <TextBlock Text="{Binding Status}" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" Margin="5,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5">
                    <Button Content="⏸" Click="PauseJob_Click" Background="#3E3E42" IsVisible="{Binding !IsPaused}"/>
                    <Button Content="▶" Click="ResumeJob_Click" Background="#007ACC" IsVisible="{Binding IsPaused}"/>
                    <Button Content="⏹" Click="StopJob_Click" Background="#660000"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="20,5,0,0">
                    <TextBlock Text="{Binding CurrentActionText}" FontSize="11" Foreground="#007ACC" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>